# What actions/checkout and claude-code-action write: every key allowed.
[core]
	repositoryformatversion = 0
	filemode = true
	bare = false
	logallrefupdates = true
[remote "origin"]
	url = https://github.com/fixture-owner/fixture-repo
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
[user]
	name = fixture-bot
	email = fixture-bot@example.com
