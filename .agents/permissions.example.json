{
  "$schema": "https://antigravity.google/schemas/v1/settings.json",
  "permissions": {
    "allow": [
      "command(gh issue view)",
      "command(gh issue list)",
      "command(gh issue status)",
      "command(gh pr view)",
      "command(gh pr list)",
      "command(gh pr diff)",
      "command(gh pr checks)",
      "command(gh pr status)",
      "command(gh repo view)",
      "command(gh label list)",
      "command(gh run view)",
      "command(gh run list)",
      "command(gh run watch)",
      "command(gh auth status)",
      "command(regex:gh api (?!.*(-X|--method|-f|-F|--field|--raw-field|--input|graphql)).*)",
      "command(git status)",
      "command(git diff)",
      "command(git log)",
      "command(git show)",
      "command(git fetch)",
      "command(git switch)",
      "command(git merge-base)",
      "command(git merge-tree)",
      "command(git rev-parse)",
      "command(git ls-files)",
      "command(npm test)",
      "command(npm run format)",
      "command(npm run format:check)",
      "command(node --test)",
      "command(uv run pytest)",
      "command(uv run ruff)"
    ],
    "ask": [
      "command(regex:gh api .*(-X|--method|-f|-F|--field|--raw-field|--input|graphql).*)",
      "command(gh pr merge)",
      "command(gh pr close)",
      "command(gh pr create)",
      "command(gh issue create)",
      "command(gh issue close)",
      "command(gh issue delete)",
      "command(gh release)",
      "command(gh secret)",
      "command(gh variable)",
      "command(gh repo delete)",
      "command(gh label create)",
      "command(gh label delete)",
      "command(gh workflow run)",
      "command(git push)",
      "command(git reset)",
      "command(git clean)",
      "command(git rebase)",
      "command(git restore)",
      "command(git tag)",
      "command(git worktree remove)",
      "command(git config)",
      "command(npm publish)",
      "command(curl)",
      "command(wget)",
      "command(Invoke-WebRequest)",
      "command(Invoke-RestMethod)",
      "command(rm)",
      "command(Remove-Item)",
      "command(ssh)",
      "command(scp)",
      "command(docker)",
      "command(regex:.*(cut-release|prepare-release)\\.sh.*)",
      "command(regex:.*records\\.mjs (upload|upload-raw|prune).*)"
    ],
    "deny": [
      "command(rm -rf /)",
      "command(rm -rf ~)",
      "command(rm -rf .git)",
      "command(sudo)",
      "command(runas)",
      "command(gh auth token)",
      "command(Invoke-Expression)",
      "command(iex)",
      "command(regex:git push .*(--force|-f|--mirror|--delete).*)",
      "command(regex:(curl|wget|iwr|Invoke-WebRequest).*\\|.*(sh|bash|iex|Invoke-Expression).*)",
      "write_file(.git/)",
      "read_file(.env)",
      "write_file(.env)"
    ]
  }
}
